# Copy to .env and replace the values. Never commit .env.
# Generate strong values, e.g.:  openssl rand -base64 32

# Database owner (used only for migrations / admin)
POSTGRES_PASSWORD=change-me-owner-password

# Least-privilege role the Go service connects as
ZEROID_APP_DB_PASSWORD=change-me-app-password

# Connection string for the Go service (uses the app role, not the owner)
DATABASE_URL=postgres://zeroid_app:change-me-app-password@localhost:5432/zeroid?sslmode=disable
